{
  "name": "canvaspp",
  "version": "0.1.0",
  "private": true,
  "description": "Canvas++ — pizarra infinita sincronizada con tu NAS",
  "author": "Esther pKa",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "android:sync": "npm run build && node scripts/android-setup.mjs",
    "android:open": "npx cap open android",
    "win:dev": "npm run build && electron .",
    "win:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "perfect-freehand": "^1.2.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.estherpka.canvaspp",
    "productName": "Canvas++",
    "directories": {
      "output": "electron/release"
    },
    "files": [
      "dist/**",
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "canvaspp": {
    "updateRepo": "pkatheassh0l3/Canvas-"
  }
}
